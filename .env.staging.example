# Staging env template (safe to commit). Copy to .env.staging on the VPS:
#   cp .env.staging.example .env.staging && chmod 600 .env.staging && nano .env.staging

# Same pattern as prod/dev: one string for qalam-api + messaging-api
DB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=qalam_staging;User Id=qalam_staging_user;Password=Qalam@2026;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

MIGRATE_ON_STARTUP=true
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@staging.qalam.net.sa
DEFAULT_ADMIN_PASSWORD=

ENCRYPTION_KEY=
JWT_SECRET=
JWT_ISSUER=QalamProject-Staging
JWT_AUDIENCE=QalamProjectUsers-Staging

RABBITMQ_USER=qalam
RABBITMQ_PASS=

CORS_ALLOWED_ORIGINS=https://teacher-staging.qalam.net.sa,https://admin-staging.qalam.net.sa,https://api-staging.qalam.net.sa

EMAIL_HOST=mail.dmail.sa
EMAIL_PORT=465
EMAIL_ENABLE_SSL=true
EMAIL_SECURE_SOCKET_MODE=SslOnConnect
EMAIL_FROM_NAME=Qalam Learning Platform (Staging)
EMAIL_FROM_EMAIL=info@qalam.net.sa
EMAIL_USERNAME=info@qalam.net.sa
EMAIL_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FIREBASE_KEY_PATH=
FIREBASE_PROJECT_ID=

OSS_ACCESS_KEY_ID=
